{
    "name": "n8n-nodes-openshield",
    "version": "0.1.1",
    "description": "n8n node for OpenShield: image and text moderation and fraud decisions",
    "license": "MIT",
    "homepage": "https://github.com/SwayLtd/n8n-nodes-openshield#readme",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "openshield",
        "moderation",
        "content-moderation",
        "fraud",
        "fraud-detection"
    ],
    "author": {
        "name": "Sway SRL",
        "email": "support@openshield.dev",
        "url": "https://www.openshield.dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SwayLtd/n8n-nodes-openshield.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease",
        "test": "tsc -p tsconfig.test.json && node --test \".test-dist/test/*.test.js\""
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/OpenShieldApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/OpenShield/OpenShield.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.57.4",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
